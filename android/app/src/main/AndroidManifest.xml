<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- স্ক্রিন টাইম: অ্যাপ-ভিত্তিক ব্যবহারের সময় পড়ার জন্য (সেটিংসে "Usage access" থেকে ব্যবহারকারী নিজে দেন) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- System-wide floating bubble (Messenger-style chat head) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- For project lock (fingerprint / device PIN via local_auth) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- চাকরি হাব থেকে SmartStudyBD খুঁজে পাওয়ার জন্য (Android 11+ প্যাকেজ ভিজিবিলিটি) -->
    <queries>
        <package android:name="com.hanif.smartstudy"/>
        <package android:name="com.google.android.apps.wellbeing"/>
        <package android:name="com.samsung.android.forest"/>
        <!-- অ্যাপের নাম (লেবেল) দেখানোর জন্য ইনস্টল করা সব লঞ্চেবল অ্যাপ দেখতে পাওয়া -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>

    <application
        android:label="My Manager"
        android:name=".MyManagerApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:importantForAutofill="noExcludeDescendants"
        android:theme="@style/LaunchTheme">

        <!-- android:importantForAutofill="noExcludeDescendants" above:
             once this app becomes the active system Autofill service, any
             text field anywhere — including our own Vault's "add new
             password" form — would otherwise also trigger an autofill
             fill-request back to us. That is very likely what was
             crashing the app the moment the person tapped into the title
             field of a new Vault entry: typing in our own field asks our
             own autofill service to look itself up, a self-referential
             path the plugin probably never anticipated. This tells
             Android to never treat any view in this app as fillable, so
             that fill/save requests only ever come from OTHER apps —
             exactly the actual use case, and never our own screens. -->

        <!-- Read by flutter_autofill_service (application-level meta-data,
             not tied to any one <activity> tag) to know which Activity to
             launch for the interactive "pick a login" / "save this login"
             UI. Without this, the plugin falls back to a hardcoded
             component name from its own example app
             (com.keevault.flutter_autofill_service_example.AutofillActivity)
             which does not exist in this app — that mismatch is a very
             plausible cause of a crash the moment Android actually tries
             to launch the autofill UI. -->
        <meta-data
            android:name="com.keevault.flutter_autofill_service.ACTIVITY_NAME"
            android:value="com.hanif.mymanager.AutofillActivity"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/NormalTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- "Share TO My Manager" — lets other apps (browser, gallery,
                 WhatsApp, etc.) share text, links, images, or files
                 straight into a new idea. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- Autofill picker / save UI: একটা আসল আলাদা Activity (alias নয়),
             নিজের খালি taskAffinity সহ — যাতে অন্য অ্যাপের উপরেই খোলে,
             মূল My Manager টাস্ক টেনে না আনে। Dart entrypoint
             AutofillActivity.kt থেকে "autofillEntryPoint" সেট হয়।
             exported=true লাগে কারণ সিস্টেমের autofill প্রসেস PendingIntent
             দিয়ে এটা চালু করে। -->
        <activity
            android:name=".AutofillActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/AutofillTheme"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Home screen widget — today's pending/overdue overview -->
        <receiver
            android:name=".MyManagerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/my_manager_widget_info"/>
        </receiver>

        <!-- ক্যাশবুক হোম-স্ক্রিন উইজেট (ব্যালেন্স + দ্রুত জমা/খরচ) -->
        <receiver
            android:name=".CashbookWidgetProvider"
            android:exported="false"
            android:label="ক্যাশবুক">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cashbook_widget_info"/>
        </receiver>

        <!-- উইজেট থেকে খোলা দ্রুত-এন্ট্রি শিট: স্বচ্ছ, নিজের খালি taskAffinity, রিসেন্টসে আসে না -->
        <activity
            android:name=".CashbookQuickAddActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/AutofillTheme"
            android:windowSoftInputMode="adjustResize"/>

        <!-- বাবলের ভাসমান প্যানেল (পথ B): আসল Activity — স্বচ্ছ থিম,
             ছোট ভাসমান উইন্ডোর মাপ BubbleActivity নিজে বসায়। ডটে
             ট্যাপ করলে BubbleService এটা খোলে/বন্ধ করে। -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/BubbleTheme"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Floating bubble (Messenger-style chat head): own foreground
             service — no third-party overlay plugin anymore. The dot and
             drag-to-dismiss are owned by BubbleService; the panel is
             BubbleActivity (a real Activity, not an overlay window). -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="my_manager_bubble"/>
        </service>

        <!-- Reminder notifications' Done / Not yet buttons: this receiver
             is what lets a button tap be handled while the app is closed. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Password Vault Autofill Service — CONFIRMED (from an actual
             on-device test) that flutter_autofill_service already merges
             in its own correct <service> declaration from its own
             library manifest (it shows up in Android Settings as
             "Flutter Autofill Service"). The <service> block that used
             to be here was my own extra, guessed-at duplicate pointing
             at a class name I could never fully verify — selecting IT
             specifically (shown as "My Manager Autofill" in Settings,
             distinct from the plugin's own working entry) was the actual
             cause of the crash-loop. Removed entirely rather than fixed,
             since the plugin's own entry already does the job; the
             ACTIVITY_NAME meta-data and activity-alias above are
             unaffected by this and still apply regardless of which
             manifest declared the <service> itself. If a custom label
             ("My Manager Autofill" instead of the generic "Flutter
             Autofill Service") is wanted later, that needs a
             tools:replace manifest-merge override on the plugin's own
             component, not a second competing <service> block. -->

        <!-- "My Manager Autofill (শুধু সেভ করা)": প্লাগইনের সার্ভিসের সামনের ছাঁকনি। সাধারণ টেক্সটবক্সে
             চিপ দেখায় না; লগইন ফর্ম বা সেভ করা সাইট/অ্যাপে প্লাগইনকে ডাকে। এটা আলাদা এন্ট্রি —
             ফোনের Settings > Autofill service থেকে এটা বাছলে চালু হয়; আগেরটা (Flutter Autofill
             Service) যেমন ছিল তেমনই থাকে, চাইলে ফিরে যাওয়া যায়। -->
        <service
            android:name=".FilteredAutofillService"
            android:label="My Manager Autofill (শুধু সেভ করা)"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService"/>
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config"/>
        </service>

        <!-- ফাইল-পিকারে "ডকুমেন্ট ভল্ট" চাপলে VaultDocumentsProvider এটা PendingIntent দিয়ে চালু করে:
             যাচাই + ভল্ট থেকে ফাইল বাছা। নিজের PendingIntent দিয়ে চলে, তাই exported লাগে না। -->
        <activity
            android:name=".VaultPickActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/AutofillTheme"
            android:windowSoftInputMode="adjustResize"/>

        <!-- ডকুমেন্ট ভল্ট → ফাইল-পিকারের সোর্স: ব্রাউজার/ওয়েবসাইটে "Choose file" চাপলে গ্যালারির
             মতো "ডকুমেন্ট ভল্ট" দেখায়। শুধু ব্যবহারকারীর "আপলোডের জন্য প্রস্তুত করো" চাপা
             ফাইল (১০ মিনিট) দেখায়, এনক্রিপ্টেড ভল্ট নয়। MANAGE_DOCUMENTS থাকায় শুধু
             সিস্টেম পিকার এটা ডাকতে পারে। -->
        <provider
            android:name=".VaultDocumentsProvider"
            android:authorities="${applicationId}.vaultdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
            <!-- Job Radar: বেছে দেওয়া চাকরির অ্যাপের নোটিফিকেশন পড়ার সার্ভিস (ব্যবহারকারী Settings থেকে নিজে অনুমতি দেন) -->
        <service
            android:name=".JobNotificationListener"
            android:label="Job Radar"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

    </application>
</manifest>
